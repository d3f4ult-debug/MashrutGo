# Copy to frontend/.env (never commit real keys).

# Backend API. Leave empty in development: Vite proxies /api (REST + WebSocket) to http://127.0.0.1:8000.
# Production example (API on another host): VITE_API_BASE=https://api.mashrutgo.uz/api/v1
VITE_API_BASE=

# WebSocket base. Empty = derived from VITE_API_BASE / the page origin (…/api/v1/ws).
# Production example: VITE_WS_BASE=wss://api.mashrutgo.uz/api/v1/ws
VITE_WS_BASE=

# MapTiler vector maps (https://cloud.maptiler.com/). Empty = OpenStreetMap raster tiles.
VITE_MAPTILER_KEY=
