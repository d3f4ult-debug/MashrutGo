# ==============================================================================
# Andijon Smart Route Platform (MashrutGo) — backend configuration example
# Copy to `backend/.env` and adjust. NEVER commit real secrets.
# ==============================================================================

# --- Application core ---
APP_ENV=development                 # development | test | production
APP_NAME="Andijon Transport Platform"
API_V1_PREFIX=/api/v1
# Production refuses to start with the default key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:5173
# Reverse proxies whose X-Forwarded-For may be trusted (comma separated). Empty = trust nobody,
# so the audit log records the direct peer. Set it to your nginx/ingress address in production.
TRUSTED_PROXIES=

# --- First Super Admin (created only when none exists; required in production) ---
BOOTSTRAP_ADMIN_PHONE=+998901234567
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# --- Database ---
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/andijon_transport
AUTO_MIGRATE=true                   # run `alembic upgrade head` on startup
SEED_DEMO_DATA=true                 # Andijon demo routes/vehicles/drivers (forbidden in production)

# --- Maps & geocoding (MapTiler) ---
MAPTILER_API_KEY=
MAPTILER_BASE_URL=https://api.maptiler.com

# --- Road routing for the Route Editor ---
# osrm: real road geometry. The public demo server has fair-use limits — self-host OSRM for production.
# geodesic: straight segments, offline only (UI shows a warning).
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10

# --- Payments: Click (SHOP API) ---
# Webhooks to configure in the Click merchant cabinet:
#   Prepare  URL: https://<api-host>/api/v1/payments/webhook/click/prepare
#   Complete URL: https://<api-host>/api/v1/payments/webhook/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
# Dev only: lets top-ups complete without Click credentials (ignored when APP_ENV=production)
PAYMENTS_SANDBOX=true

# --- Payments: future adapters (not implemented yet) ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# --- Push notifications (FCM HTTP v1) ---
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=./fcm-service-account.json

# --- Realtime / tracking ---
GPS_STALE_THRESHOLD_SECONDS=45
PARKING_GEOFENCE_DEFAULT_RADIUS_METERS=100
CLIENT_WATCH_HEARTBEAT_TIMEOUT_SECONDS=90
BACKGROUND_SWEEP_INTERVAL_SECONDS=10

# --- Security ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
# Public endpoint throttles, requests per minute per client address
RATE_LIMIT_ROUTE_SEARCH_PER_MINUTE=30
RATE_LIMIT_ETA_PER_MINUTE=90
RATE_LIMIT_WATCH_START_PER_MINUTE=20
