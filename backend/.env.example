# ==============================================================================
# Andijon Transport Platform — Backend Environment Configuration Example
# Copy this file to `.env` in the backend root and adjust values as needed.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PRIVATE KEYS TO VERSION CONTROL!
# ==============================================================================

# --- Application Core ---
APP_ENV=development
APP_NAME="Andijon Transport Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-please-change-to-a-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- Database Configuration ---
# SQLite for local MVP development:
DATABASE_URL=sqlite:///./app.db
# PostgreSQL for production / staging migration (uncomment when using Postgres):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/andijon_transport

# --- Map & Geocoding & Routing Provider (MapTiler) ---
MAPTILER_API_KEY=placeholder_maptiler_api_key
MAPTILER_BASE_URL=https://api.maptiler.com

# --- Payments: Click Provider Adapter ---
# Provider integration keys for Click Uzbekistan (TEST / DEMO credentials)
CLICK_SERVICE_ID=placeholder_click_service_id
CLICK_MERCHANT_ID=placeholder_click_merchant_id
CLICK_SECRET_KEY=placeholder_click_secret_key
CLICK_MERCHANT_USER_ID=placeholder_click_merchant_user_id

# --- Payments: Future Adapters (Payme, Uzum, HUMO) ---
PAYME_MERCHANT_ID=placeholder_payme_merchant_id
PAYME_SECRET_KEY=placeholder_payme_secret_key
UZUM_MERCHANT_ID=placeholder_uzum_merchant_id
UZUM_SECRET_KEY=placeholder_uzum_secret_key

# --- Push Notifications: Firebase Cloud Messaging (FCM) ---
FCM_ENABLED=false
FCM_PROJECT_ID=placeholder_fcm_project_id
FCM_CREDENTIALS_PATH=./fcm-service-account.json

# --- Realtime, Tracking & GPS Thresholds ---
# How long without GPS ping before vehicle is considered offline/stale (seconds)
GPS_STALE_THRESHOLD_SECONDS=45
# Default geofence radius in meters for Stayanka / Parking detection
PARKING_GEOFENCE_DEFAULT_RADIUS_METERS=100
# Client watch heartbeat timeout (seconds) before client exact GPS broadcast terminates
CLIENT_WATCH_HEARTBEAT_TIMEOUT_SECONDS=60
